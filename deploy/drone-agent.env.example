# Install as /etc/drone-agent.env with mode 0600. Never commit real credentials.
DRONE_SERVER_URL=https://game.example.test
DRONE_USERNAME=team-user
DRONE_PASSWORD=replace-me

# Use a stable match identifier so a restart restores the correct snapshot.
DRONE_MATCH_ID=competition-match
DRONE_PLANNING_ENABLED=true
DRONE_SNAPSHOT_INTERVAL_S=10
DRONE_RESTART_INITIAL_BACKOFF_S=0.25
DRONE_RESTART_MAX_BACKOFF_S=5
